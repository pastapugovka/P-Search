# Сервер
PORT=3000
HOST=0.0.0.0
ORIGIN=http://localhost:3000
CORS_ORIGIN=*
# Авторизация: пусто = доступ открыт. Если задан — все /api/* требуют
# Authorization: Bearer <ключ> или X-API-Key: <ключ> (кроме health, openapi, docs).
API_KEY=

# ИИ-режим: реальные вызовы моделей (RAG по результатам поиска)
# Провайдеры: openai, anthropic, google, deepseek, groq, mistral, moonshot,
# minimax, x-ai, openrouter, together, fireworks, cerebras, ollama, lmstudio
# (ollama и lmstudio работают локально, ключ им не нужен).
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Кастомный base-url для OpenAI-совместимых провайдеров
AI_BASE_URL=

# Данные и обучение
SEARCH_DATA=./data/search-content.json
SEARCH_DB=./data/s-db.json
SEARCH_LEARN=dataset
SEARCH_BACKUP=true
APP_NAME=Поисковая система
BOT_NAME=

# Поиск
SEARCH_LIMIT=20
SEARCH_FUZZY=true
SEARCH_LANG=auto
SEARCH_TITLE_WEIGHT=5.0
SEARCH_KEYWORDS_WEIGHT=2.5
SEARCH_BODY_WEIGHT=1.0
SEARCH_K1=1.2
SEARCH_B=0.75

# Отображение
SEARCH_SNIPPET_WIDTH=42
SEARCH_MAX_FRAGMENTS=2
SEARCH_MARK_TAG=mark
SEARCH_LEVENSHTEIN_LIMIT=2